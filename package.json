{
  "name": "education-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm -r --if-present dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "audit:security": "tsx tools/security-audit/cli.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env packages/vector-store/src/cli/migrate.ts",
    "probe:embeddings": "tsx --env-file-if-exists=.env playground/probe-embeddings.ts",
    "probe:retrieval": "tsx --env-file-if-exists=.env playground/probe-retrieval.ts",
    "probe:generate": "tsx --env-file-if-exists=.env playground/probe-generate.ts",
    "test:retrieval": "RUN_RETRIEVAL_QUALITY=1 pnpm --filter @education-ai/vector-store test",
    "dev:api": "pnpm --filter @education-ai/api dev",
    "dev:web": "pnpm --filter @education-ai/web dev",
    "dev:worker": "pnpm --filter @education-ai/worker dev",
    "build:api": "pnpm --filter @education-ai/api build",
    "build:web": "pnpm --filter @education-ai/web build",
    "build:worker": "pnpm --filter @education-ai/worker build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
