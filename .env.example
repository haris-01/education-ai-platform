# Copy to .env and fill in. .env is gitignored.

# Postgres + pgvector, as started by `pnpm db:up`.
DATABASE_URL=postgresql://education_ai:education_ai@127.0.0.1:5433/education_ai

# Google AI Studio (https://aistudio.google.com/apikey). Free tier is
# enough for this corpus. Only needed to embed with a real model — every
# test in the repo runs without it, using the fake embedder.
GEMINI_API_KEY=
